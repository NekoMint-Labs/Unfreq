:80 {
	encode zstd gzip

	handle /api/og/* {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /health* {
		reverse_proxy api:4000
	}

	handle /web-health {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		# Server mode requires an HTTPS public origin; the hop from NPM is HTTP.
		# Use that policy instead of trusting a client-supplied forwarded scheme.
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
