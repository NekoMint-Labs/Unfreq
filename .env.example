API_HOST=0.0.0.0
API_PORT=4000
AUTH_LOGIN_CHALLENGE_TTL_SECONDS=600
AUTH_LOGIN_CODE_RESPONSE=disabled
AUTH_LOGIN_DELIVERY_MODE=local-log
AUTH_LOGIN_MAX_VERIFY_ATTEMPTS=5
AUTH_LOGIN_REQUEST_COOLDOWN_SECONDS=60
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=local-fallback
AI_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_PROVIDER=dashscope
EMBEDDING_VERSION=v1
DATABASE_URL=postgres://postgres:postgres@postgres:5432/unfreq
DB_POOL_MAX=10
HEALTH_DEPENDENCY_TIMEOUT_MS=1500
IMAGE_MAX_BYTES=2097152
IMAGE_STORAGE_DIR=/app/storage/images
LOG_LEVEL=info
NODE_ENV=production
REDIS_URL=redis://redis:6379
PROVIDER_CONFIG_SECRET=replace-this-with-at-least-32-random-characters
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=local-disabled
RERANKER_PROVIDER=disabled
SESSION_SECRET=replace-this-with-at-least-32-random-characters
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=cosyvoice-v3-flash
TTS_PROVIDER=dashscope
TTS_STORAGE_DIR=/app/storage/audio/programs
TTS_VOICE_LEFT=longxiaochun
TTS_VOICE_RIGHT=longcheng
WEB_ORIGIN=https://your-domain.example
UNFREQ_PROXY_NETWORK=npm_default
