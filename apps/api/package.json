{
  "name": "@unfreq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "admin:promote": "node dist/scripts/promote-admin.js",
    "ai:signals:evaluate": "node dist/scripts/evaluate-signal-quality.js",
    "dev": "tsx watch src/server.ts",
    "embeddings:backfill": "node dist/scripts/backfill-embeddings.js",
    "galaxy:backfill": "node dist/scripts/backfill-galaxy-positions.js",
    "lint": "eslint .",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "signals:seed": "node dist/scripts/seed-signals.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unfreq/contracts": "0.1.0",
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.1.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
