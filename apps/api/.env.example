API_HOST=127.0.0.1
API_PORT=4000
AUTH_LOGIN_CHALLENGE_TTL_SECONDS=600
AUTH_LOGIN_CODE_RESPONSE=enabled
AUTH_LOGIN_DELIVERY_MODE=local-log
AUTH_LOGIN_MAX_VERIFY_ATTEMPTS=5
AUTH_LOGIN_REQUEST_COOLDOWN_SECONDS=60
# Local synthetic request limits apply without JSON; remote Provider dispatch
# needs a complete explicit policy. Production also forbids local-log/code echo.
ABUSE_PROTECTION_ENABLED=true
ABUSE_LIMITS_JSON=
TRUSTED_PROXY_CIDRS=
AI_API_KEY=
AI_BASE_URL=
AI_FAST_API_KEY=
AI_FAST_BASE_URL=
AI_FAST_MODEL=
AI_FAST_PROVIDER=
AI_MODEL=local-fallback
AI_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_PROVIDER=dashscope
EMBEDDING_VERSION=v1
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=cosyvoice-v3-flash
TTS_PROVIDER=dashscope
TTS_STORAGE_DIR=storage/audio/programs
TTS_VOICE_LEFT=longxiaochun
TTS_VOICE_RIGHT=longcheng
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/unfreq
DB_POOL_MAX=10
# Generation consumers sharing one database must use the same concurrency.
# Full defaults and rollout sequence: docs/implementation/b1-generation-operations.md
SIGNAL_GENERATION_WORKER_ENABLED=true
SIGNAL_GENERATION_CONCURRENCY=2
SIGNAL_GENERATION_ATTEMPT_TIMEOUT_MS=180000
SIGNAL_GENERATION_SHUTDOWN_GRACE_MS=10000
SIGNAL_GENERATION_DB_STATEMENT_TIMEOUT_MS=5000
SIGNAL_GENERATION_DB_LOCK_TIMEOUT_MS=1000
HEALTH_DEPENDENCY_TIMEOUT_MS=1500
IMAGE_MAX_BYTES=2097152
IMAGE_STORAGE_DIR=storage/images
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
PROVIDER_CONFIG_SECRET=
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=local-disabled
RERANKER_PROVIDER=disabled
SESSION_SECRET=replace-with-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
